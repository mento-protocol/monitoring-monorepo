# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it.

# ── Vercel ────────────────────────────────────────────────────────────────────
# Create at: vercel.com → Account Settings → Tokens
vercel_token = "vcp_..."

# Team ID — default is already set in variables.tf; override only if changed.
# vercel_team_id = "team_4l4TPoxnWEcusT8VeXkHbzF2"

# ── GitHub ────────────────────────────────────────────────────────────────────
# PAT for writing repository Actions secrets, variables, settings, and the main
# lifecycle ruleset on `mento-protocol/monitoring-monorepo`. Fine-grained PAT
# scoped to that repository. Organization administration is not required.
#
# Create at: https://github.com/settings/personal-access-tokens/new
#   Resource owner: mento-protocol
#   Repository access: mento-protocol/monitoring-monorepo
#   Permissions: Repository → Secrets: Read/write, Variables: Read/write,
#     Administration: Read/write, Environments: Read/write
#     (Variables is required for terraform_apply_slack_channel below;
#      Administration is required by github_workflow_repository_permissions in
#      github-actions-permissions.tf — issue #1557 — and the lifecycle
#      github_repository_ruleset in github-main-lifecycle-ruleset.tf — issue
#      #2091. Environments is required by the
#      sentry-pipeline GitHub Environment + its environment secrets in
#      github-environment.tf — issue #1289. GitHub scopes these repo
#      permissions independently. All are repo-level — org-admin is still NOT
#      needed. Do not grant Contents. Keep this human-operated credential out
#      of Actions and other automation.)
github_token = "github_pat_..."

# The approved numeric merge-operator Team ID is pinned in reviewed source at
# human-merge-boundary-policy.json. It is not an operator tfvar. Replace that
# file's zero sentinel only after a human organization administrator creates
# and verifies the Team.

# Local agent GitHub App identity. A human creates and installs this App outside
# Terraform because the platform token remains repository-scoped. Keep the App
# off every ruleset bypass list. At the first cutover, grant only Actions read,
# Issues write, and Pull requests write. Do not grant Administration, Contents,
# Workflows, Checks, or organization Projects. The source-disabled Git and
# issue-board profiles need a separate reviewed implementation, App-permission
# change, and activation proof. Install the App only on
# mento-protocol/monitoring-monorepo.
#
# App/team creation, the platform credential apply, broker activation, and
# local credential cutover are separate approvals. GitHub first downloads the
# PEM into the transient operator-owned intake file defined by
# docs/notes/local-agent-github-app-credential.md. Use its mode-0700 directory,
# mode-0600 file, transfer, removal, and revoke-on-uncertain-custody procedure.
# Keep the operational PEM copy in this gitignored operator file on a human-only
# checkout that no agent can read. The guarded
# Terraform wrapper makes one mode-0600 execution copy in its mode-0700 private
# plan directory. It reuses that copy for the exact plan and apply, then deletes
# the directory in `finally`. Terraform sends the value to Secret Manager's
# write-only field. Do not put it in an
# environment variable, shell argument, tracked or agent-accessible repository
# file, GitHub Actions secret, keychain entry, browser session, or generated
# artifact.
# After provisioning, the runtime broker keeps PEM, JWT, and token bytes in
# pipes or process memory. It does not use a temporary file. The root-owned
# broker and its Google credential use a separate OS account. The agent account
# gets only the installed broker command and normalized operation results. It
# never receives an installation token.
# The broker is not the only cloud reader: protected org-terraform has project
# Owner, and production-infra-applier can impersonate it. The App still has no
# Administration permission and no ruleset bypass.
# The reviewed policy keeps the complete broker scaffold absent by default.
# Phase 3 creates only the disabled lifecycle ruleset. A separate Phase 4
# source change enables the scaffold and pins its impersonator before these
# values can create anything. That guarded plan must create the service account,
# secret container, credential version, accessor binding, and impersonation
# binding together, with no unrelated change.
local_agent_github_app_id                           = 0
local_agent_github_app_installation_id              = 0
local_agent_github_app_credential_active            = false
local_agent_github_app_private_key_rotation_counter = 0
# When credential_active is true, use a complete PKCS#1 or PKCS#8 PEM envelope
# of at most 65,536 bytes. Omitted, blank, malformed, and oversized values fail
# during input validation. Keep the real value only in this gitignored,
# operator-owned file.
# local_agent_github_app_private_key = <<-PEM
#   <operator-supplied PEM private key>
# PEM

# Dedicated READ-ONLY audit PAT for the daily platform-settings drift check
# (.github/workflows/platform-settings-drift.yml, issue #1564). Separate from
# github_token above: it is a CI secret (mirrored to PLATFORM_SETTINGS_AUDIT_TOKEN),
# so it must NEVER hold write scope. It reads the workflow-permission and
# repository-ruleset endpoints to confirm the default workflow token and both
# main rulesets still match the platform stack.
#   Create at: https://github.com/settings/personal-access-tokens/new
#     Resource owner: mento-protocol
#     Repository access: mento-protocol/monitoring-monorepo
#     Permissions: Repository → Administration: Read-only (nothing else)
#     In particular, do not grant Contents.
# Before ruleset activation, the source policy may keep the ruleset leg inert.
# After activation, leaving this unset makes the workflow fail visibly.
# platform_settings_audit_token = "<administration-read-only-fine-grained-PAT>"

# Slack channel that receives the Terraform apply-pending prompt for
# alerts-rules / alerts-delivery / aegis / governance-watchdog (mirrored to
# the TERRAFORM_APPLY_SLACK_CHANNEL GitHub Actions variable). Default matches
# the workflows' hardcoded fallback, so leaving this unset changes nothing.
# See docs/notes/slack-github-subscriptions.md.
# terraform_apply_slack_channel = "#deploys"

# ── Upstash ───────────────────────────────────────────────────────────────────
# Human-owned provider bootstrap credentials. Creation and rotation follow
# docs/adr/0060-upstash-management-key-bootstrap.md; agents never mutate keys.
upstash_email   = "your@email.com"
upstash_api_key = "..."

# Primary region for the Redis database — closest to your Vercel deployment region.
# upstash_region = "eu-west-1"

# ── Hasura / Envio ────────────────────────────────────────────────────────────
# Default in variables.tf points to the current Envio endpoint.
# Override here only if the deployment ID changes.
# hasura_url = "https://indexer.hyperindex.xyz/2f3dd15/v1/graphql"

# Optional hosted testnet Envio endpoints. Each hosted testnet network stays
# hidden unless its URL is set and show_testnet_networks is true.
# hasura_testnet_url = "https://indexer.hyperindex.xyz/<testnet-deployment>/v1/graphql"
# hasura_celo_sepolia_url = "https://indexer.hyperindex.xyz/<celo-sepolia-deployment>/v1/graphql"
# show_testnet_networks = true

# ── Integration Probes ────────────────────────────────────────────────────────
# LI.FI API key for the scheduled integration-probes workflow.
# Leave empty until provisioned; the GitHub Actions secret resource is
# `count`-gated so `terraform apply` succeeds without it.
# lifi_api_key = "..."

# Fly.trade (Magpie) API key for the scheduled integration-probes workflow.
# Leave empty until provisioned; the GitHub Actions secret resource is
# `count`-gated so `terraform apply` succeeds without it.
# flytrade_api_key = "..."

# OpenOcean Pro API key for the scheduled integration-probes workflow.
# Leave empty until provisioned; the GitHub Actions secret resource is
# `count`-gated so `terraform apply` succeeds without it.
# openocean_api_key = "..."

# Squid integrator id for the scheduled integration-probes workflow.
# Leave empty until provisioned; the GitHub Actions secret resource is
# `count`-gated so `terraform apply` succeeds without it.
# squid_integrator_id = "..."

# ── Sentry triage/autofix (ADR 0036) ──────────────────────────────────────────
# READ-ONLY Sentry internal-integration token for the triage pipeline.
# Scopes: Issue & Event Read, Project Read, Organization Read — NO write scopes.
# Leave empty until provisioned; the GitHub Actions secret resource is
# `count`-gated so `terraform apply` succeeds without it. See the human runbook
# in docs/notes/sentry-triage-pipeline.md for how to mint it.
# sentry_triage_token = "xxx-read-only-sentry-token-xxx"

# Claude Max OAuth token from `claude setup-token` for claude-code-action.
# Leave empty until provisioned; the GitHub Actions secret resource is
# `count`-gated so `terraform apply` succeeds without it.
# CAUTION: the CLAUDE_CODE_OAUTH_TOKEN repo secret already exists live and is
# shared with .github/workflows/claude.yml — setting this value overwrites
# (rotates) it on apply, so it must be a fresh working `claude setup-token`
# value, and once applied it must never be emptied (the resource has
# `prevent_destroy`). See the runbook in docs/notes/sentry-triage-pipeline.md.
# claude_code_oauth_token = "xxx-claude-oauth-token-xxx"

# Kill switch for the scheduled Sentry triage workflows (string "true"/"false",
# default "false"). Flip to "true" only after both Phase-1 workflow PRs are
# merged AND the two tokens above are provisioned. Still IaC — set it here and
# re-apply, never via the GitHub UI.
# sentry_triage_enabled = "false"

# Fine-grained GitHub PAT for the verdict-projection step (ADR 0038): Issues
# Read+Write on EXACTLY frontend-monorepo, mento-analytics-api, minipay-dapp —
# no contents, no pull-requests, no other repos. Leave empty until provisioned;
# the GitHub Actions secret resource is `count`-gated so `terraform apply`
# succeeds without it and the workflow no-ops gracefully. Brand-new, no external
# consumers, so no `prevent_destroy`. See docs/notes/sentry-triage-pipeline.md
# for how to mint the `sentry-triage-projector` PAT.
# sentry_projection_token = "github_pat_xxx-issues-rw-three-repos-xxx"

# ── Sentry autofix PRs (ADR 0036 Phase 2b) ────────────────────────────────────
# GitHub App credential for the autofix leg's branch push + PR create (so
# required CI + Codex review fire on the fix PR — a `github.token` push does
# not trigger downstream workflows). Create the App once, then set both values.
# Runbook: docs/notes/sentry-triage-pipeline.md → "Activating autofix PRs".
#   GitHub → Settings → Developer settings → GitHub Apps → New GitHub App:
#     - Permissions: Contents Read & write, Pull requests Read & write. Nothing
#       else — no Issues, no Actions, no webhooks. This is the whole trust
#       boundary.
#     - Install on `mento-protocol/monitoring-monorepo` ONLY.
#     - Record the App ID; generate a private key (downloads a PEM).
# Both are `count`-gated so `terraform apply` succeeds while empty and the
# autofix workflow no-ops. Brand-new, no external consumers, so no
# `prevent_destroy`.
# autofix_app_id = "123456"
# autofix_app_private_key = <<-PEM
#   -----BEGIN RSA PRIVATE KEY-----
#   ...paste the generated PEM here...
#   -----END RSA PRIVATE KEY-----
# PEM

# Kill switch for the scheduled autofix workflow (string "true"/"false", default
# "false"). SEPARATE from sentry_triage_enabled — flip to "true" only after this
# workflow PR merges AND the App above is provisioned. Still IaC — set it here
# and re-apply, never via the GitHub UI.
# sentry_autofix_enabled = "false"

# ── Sentry triage archive loop (ADR 0036 Phase 2a) ────────────────────────────
# WRITE-scoped Sentry token for the Phase 2a human-approved archive leg
# (ADR 0036 Stage C). Mint a SECOND internal integration in Sentry (org
# mento-labs) → Settings → Developer Settings → New Internal Integration, name
# `sentry-triage-archiver`, scopes Issue & Event: Read + Write and NOTHING else
# (no Project, no Organization, no Member). Do NOT reuse the read-only
# sentry_triage_token here. Leave empty until provisioned; the GitHub Actions
# secret resource is `count`-gated so `terraform apply` succeeds without it and
# the archive workflow no-ops gracefully. Brand-new, no external consumers, so
# no `prevent_destroy`. See docs/notes/sentry-triage-pipeline.md.
# sentry_archive_token = "xxx-write-scoped-sentry-archive-token-xxx"

# Kill switch for the Phase 2a Sentry archive workflow (string "true"/"false",
# default "false"). Flip to "true" only after the archive workflow PR is merged
# AND sentry_archive_token above is provisioned. Still IaC — set it here and
# re-apply, never via the GitHub UI.
# sentry_archive_enabled = "false"

# ── Arkham Intelligence ───────────────────────────────────────────────────────
# API key for manual /api/arkham/enrich counterparty tagging.
# Apply for access at https://intel.arkm.com/api — gated, no self-serve signup.
# The Vercel schedule is disabled while access is unavailable.
# Leave empty until provisioned; the env var resource is `count`-gated so
# `terraform apply` succeeds without it.
# arkham_api_key = "..."

# ── Dune Analytics ────────────────────────────────────────────────────────────
# API key for the nightly /api/minipay/sync cron that pulls MiniPay
# attestations from Dune query 7404332 into sharded `minipay:users:<nibble>`
# Redis SETs.
# Generate at api.dune.com → Settings → API. Same `count`-gated pattern as
# arkham_api_key — leave empty until provisioned.
# dune_api_key = "..."

# ── Grafana Cloud ─────────────────────────────────────────────────────────────
# Admin-role service account token for the Grafana Cloud stack — the SAME
# organization credential `alerts/rules` and `aegis` take as
# `grafana_service_account_token`. Create / rotate at:
#   Grafana Cloud → Administration → Service accounts → Add token.
# Required: this stack's Grafana provider mints the dashboard's read-only Viewer
# identity (`grafana-read-access.tf`) with it. It configures the provider and
# nothing else — it is never written to a Vercel env var, a GitHub secret, or
# Secret Manager. The Viewer token Terraform creates is what reaches the
# dashboard; never paste this Admin token there.
grafana_provisioning_token = "glsa_REPLACE_ME"

# Stack URL — default is already set in variables.tf; override only if it moves.
# Also becomes the dashboard's GRAFANA_QUERY_URL.
# grafana_url = "https://clabsmento.grafana.net"

# Non-secret rotation counter for the dashboard's Viewer token. Start at 1 for
# the first approved apply. Increment it to mint a replacement token and push it
# to Vercel in the same apply — the platform argument allowlist rejects
# `-replace`, so this counter is the only rotation path.
# grafana_dashboard_reader_token_rotation_counter = 1

# ── Google Cloud (metrics-bridge) ─────────────────────────────────────────────
# Find with: gcloud organizations list
gcp_org_id = "..."

# Find with: gcloud billing accounts list
gcp_billing_account = "..."

# GCP project ID — defaults to "mento-monitoring" in variables.tf.
# gcp_project_id = "mento-monitoring"

# Container image for the metrics-bridge Cloud Run service.
# Built by CI on merge to main, or manually via `pnpm bridge:deploy`.
# Omit this override to use the digest-pinned bootstrap image in variables.tf.
# Empty strings are invalid; set a concrete image only when intentionally
# changing the service's first-creation image.
# metrics_bridge_image = "europe-west1-docker.pkg.dev/mento-monitoring/metrics-bridge/metrics-bridge:abc123"

# Operator IAM — defaults to group:eng@mentolabs.xyz in variables.tf. Alloy
# preflight fingerprints this set and checks both applied submitter policies.
# gcp_dev_members = ["group:eng@mentolabs.xyz"]

# Caller must have roles/iam.serviceAccountTokenCreator on this SA.
# terraform_service_account = "org-terraform@mento-terraform-seed-ffac.iam.gserviceaccount.com"

# Grafana Alloy remote-write values. These required inputs are sensitive and
# ephemeral: Terraform passes them only to the Google provider's write-only
# `secret_data_wo` argument, so they are omitted from plan and state. Copy this
# stanza into gitignored `terraform.tfvars` or an `*.auto.tfvars` file; both are
# auto-loaded by Terraform. Never replace the tracked example values or pass the
# values on a command line. The platform wrapper makes one private mode-0600
# copy for both plan and exact-plan apply because ephemeral values are omitted
# from its private temporary saved plan. Never create, retain, upload, or print a plan
# yourself. Keep TF_LOG,
# TF_LOG_CORE, TF_LOG_PROVIDER*, TF_LOG_SDK, and TF_LOG_SDK_PROTO unset or OFF
# for platform plan/apply. Every other TF_LOG_SDK_*, including
# TF_LOG_SDK_PROTO_DATA_DIR, must be unset or empty. TF_LOG_PATH alone is
# allowed because it does not enable logging.
grafana_agent_secret_values = {
  endpoint = "https://prometheus-prod-XX-prod-region.grafana.net/api/prom/push"
  username = "REPLACE_WITH_GRAFANA_CLOUD_USERNAME"
  password = "<GRAFANA_CLOUD_ACCESS_POLICY_TOKEN>"
}

# Non-secret rotation controls. Start at 1 for the first approved Terraform
# adoption. Increment only the field whose value is intentionally rotated; the
# reviewed counter change is what triggers `secret_data_wo` to write a version.
grafana_agent_secret_rotation_counters = {
  endpoint = 1
  username = 1
  password = 1
}

# ── Read-only AI agent investigator ──────────────────────────────────────────
# IAM members allowed to impersonate `agent-readonly@mento-monitoring.iam`
# (Token Creator). Defaults to `group:eng@mentolabs.xyz` so any engineer
# inherits access; override here to add incident responders or external
# auditors. If the SA already exists in the live IAM policy (it does, in
# production), follow the one-time `terraform import` recipe at the bottom of
# `terraform/agent-readonly.tf` (section "One-time state adoption (manual
# `terraform import`)") BEFORE the first `terraform apply` that includes that
# file. Fresh org / DR bootstraps can skip the import recipe entirely.
# agent_readonly_impersonators = [
#   "group:eng@mentolabs.xyz",
#   "user:incident-responder@mentolabs.xyz",
# ]

# Project IDs in which the agent-readonly SA gets `roles/storage.objectViewer`
# (object payload reads). Empty by default — org-level grants only cover
# bucket/object *metadata* via `roles/cloudasset.viewer`. Add a project ID
# here only when an investigation legitimately needs to read object contents
# (log exports, public datasets, etc.).
# agent_readonly_storage_object_projects = ["mento-monitoring"]

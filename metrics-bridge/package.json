{
  "name": "@mento-protocol/metrics-bridge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/eslint-baseline-diff.mjs check",
    "lint:baseline:update": "node ../scripts/eslint-baseline-diff.mjs update",
    "knip": "knip --config knip.json --no-progress",
    "knip:report": "knip --config knip.json --no-exit-code --no-progress",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:canary": "node ../scripts/repo-health/mutation-harness-canary.mjs"
  },
  "dependencies": {
    "@mento-protocol/config": "workspace:*",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "prom-client": "^15.1.3",
    "viem": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "knip": "6.12.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}

[codespell]
# amountin: valid Solidity parameter name (amountIn) in ABI JSON files
# wether: genuine typo in compiled contract metadata (rawMetadata) that
#         cannot be changed without invalidating the bytecode hash
# applyable: official Terraform plan JSON field name
# zar: ISO 4217 code for the South African rand
ignore-words-list = amountin,wether,afterall,strat,applyable,zar

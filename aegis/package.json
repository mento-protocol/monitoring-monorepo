{
  "name": "@mento-protocol/aegis",
  "version": "0.0.1",
  "private": true,
  "description": "A monitoring tool to expose the result of on-chain view calls as prometheus metrics that get ingested into grafana.",
  "license": "GPL-3.0-only",
  "author": "Mento Labs <eng@mentolabs.xyz>",
  "scripts": {
    "build": "nest build",
    "agent:deploy": "cd grafana-agent && ./deploy.sh",
    "agent:preflight": "node grafana-agent/preflight.mjs",
    "agent:test": "node --test \"grafana-agent/*.test.mjs\"",
    "deploy": "./bin/deploy.sh",
    "dev": "nest start --watch",
    "format": "trunk fmt",
    "grafana": "terraform -chdir=terraform state show module.grafana_dashboard.grafana_dashboard.aegis | grep 'url' | awk -F '\"' '{print $2}'",
    "knip": "knip --config knip.json --no-progress",
    "knip:report": "knip --config knip.json --no-exit-code --no-progress",
    "lint": "node ../scripts/eslint-baseline-diff.mjs check",
    "lint:baseline:update": "node ../scripts/eslint-baseline-diff.mjs update",
    "logs": "./bin/logs.sh",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchman=false",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --watchman=false && node --test \"grafana-agent/*.test.mjs\"",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "tf:apply": "terraform -chdir=terraform apply",
    "tf:deploy": "terraform -chdir=terraform apply",
    "tf:destroy": "terraform -chdir=terraform destroy",
    "tf:init": "terraform -chdir=terraform init",
    "tf:plan": "terraform -chdir=terraform plan",
    "trunk": "trunk",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.test.ts",
      "!**/*.d.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 77,
        "functions": 87,
        "lines": 85,
        "statements": 85
      }
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    }
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/schedule": "12.0.2",
    "@willsoto/nestjs-prometheus": "6.1.1",
    "abitype": "1.3.0",
    "cron": "4.3.4",
    "js-yaml": "5.4.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@trunkio/launcher": "1.3.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jest": "30.5.2",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "volta": {
    "node": "24.22.1"
  }
}

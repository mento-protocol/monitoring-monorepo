{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "workflowAdmissionPatterns": [
    "terraform/**",
    "alerts/**",
    "aegis/**",
    "governance-watchdog/**",
    "metrics-bridge/**",
    "scripts/**",
    ".github/workflows/**",
    "terraform.stacks.json"
  ],
  "stacks": [
    {
      "id": "platform",
      "name": "Platform",
      "path": "terraform",
      "description": "Dashboard Vercel project, the dashboard's read-only Grafana service account and token, Upstash Redis, GCP project/APIs, Metrics Bridge Cloud Run shape, Aegis App Engine/Grafana Alloy bootstrap, explicit routine-deploy source buckets, separated CI Workload Identity Federation identities, project IAM, repo-level GitHub Actions secrets and variables, the controlled main lifecycle ruleset with human Team and dedicated Dependabot merge App bypasses, the source-gated main-only Dependabot merge Environment and its secrets, the source-pinned exact dedicated-App permission contract and distinct local-agent App identity, the source-gated local-agent App broker scaffold, and a dormant unapplied Peg-policy GCS source foundation. It owns no Grafana alert rules, folders, or dashboards.",
      "state": {
        "backend": "gcs",
        "bucket": "mento-terraform-tfstate-6ed6",
        "prefix": "monitoring-monorepo"
      },
      "providers": [
        "github",
        "google",
        "grafana",
        "local",
        "upstash",
        "vercel"
      ],
      "ci": {
        "validate": "changed-paths",
        "plan": "manual",
        "apply": "manual"
      },
      "applyPolicy": "human-review-required",
      "changedPathPatterns": [
        "terraform/**",
        "terraform.stacks.json",
        "scripts/terraform/check-metrics-bridge-template-plan.mjs",
        "scripts/terraform/check-metrics-bridge-template-plan.test.mjs",
        "scripts/terraform/check-main-lifecycle-boundary-plan.mjs",
        "scripts/terraform/check-main-lifecycle-boundary-plan.test.mjs",
        "scripts/terraform/terraform-fmt-check.mjs",
        "scripts/terraform/tf-platform-plan-guard.mjs",
        "scripts/workflows/check-main-rulesets-drift.mjs",
        "scripts/workflows/check-main-rulesets-drift.test.mjs",
        "scripts/workflows/read-main-rulesets.mjs",
        "scripts/workflows/read-main-rulesets.test.mjs",
        "scripts/production-infra-identity-contract/**",
        "scripts/tf-stacks.mjs",
        ".github/workflows/ci.yml",
        ".github/workflows/infra.yml",
        ".github/workflows/platform-settings-drift.yml"
      ],
      "aliases": ["pnpm infra:init", "pnpm infra:plan", "pnpm infra:apply"]
    },
    {
      "id": "peg-policy-publication",
      "name": "Peg Policy Publication",
      "path": "alerts/peg-policy-publication",
      "description": "Manual protected publication of immutable Peg policy generations from alerts/rules/peg-thresholds.json. It owns no Grafana resources or runtime attachment.",
      "state": {
        "backend": "gcs",
        "bucket": "mento-terraform-tfstate-6ed6",
        "prefix": "peg-policy-publication"
      },
      "providers": ["google"],
      "ci": {
        "validate": "changed-paths",
        "plan": "manual-main-refresh",
        "apply": "manual-production-infra-environment"
      },
      "applyPolicy": "ci-production-infra-environment-approved",
      "changedPathPatterns": [
        "alerts/peg-policy-publication/**",
        "alerts/rules/peg-thresholds.json",
        "metrics-bridge/peg-registry.json",
        "terraform/peg-policy.tf",
        "terraform/ci-wif.tf",
        "terraform.stacks.json",
        "scripts/alerts/check-peg-policy-publication.mjs",
        "scripts/alerts/check-peg-policy-publication.test.mjs",
        "scripts/alerts/check-peg-registry-integrity.mjs",
        "scripts/alerts/check-peg-registry-integrity-lineage.mjs",
        "scripts/lib/peg-policy-digest.mjs",
        "scripts/lib/hcl.mjs",
        "scripts/production-infra-identity-contract/**",
        "scripts/terraform/terraform-fmt-check.mjs",
        "scripts/tf-stacks.mjs",
        "scripts/tf-stacks.test.mjs",
        ".github/workflows/ci.yml",
        ".github/workflows/infra.yml",
        ".github/workflows/peg-policy-publication.yml"
      ]
    },
    {
      "id": "alerts-rules",
      "name": "Alerts Rules",
      "path": "alerts/rules",
      "description": "Protocol Grafana alert rules plus the Aegis service-health and testnet-health rule groups, Grafana folders, global notification policy, contact points, message templates, and mute timings.",
      "state": {
        "backend": "gcs",
        "bucket": "mento-terraform-tfstate-6ed6",
        "prefix": "alerts-rules"
      },
      "providers": ["grafana"],
      "ci": {
        "validate": "changed-paths",
        "plan": "pull-request",
        "apply": "push-main-production-infra-environment"
      },
      "applyPolicy": "ci-production-infra-environment-approved",
      "changedPathPatterns": [
        "alerts/rules/**",
        "terraform.stacks.json",
        "scripts/terraform/terraform-fmt-check.mjs",
        "scripts/tf-stacks.mjs",
        ".github/workflows/ci.yml",
        ".github/workflows/infra.yml",
        ".github/workflows/alerts-rules.yml"
      ],
      "aliases": ["pnpm alerts:rules:init", "pnpm alerts:rules:plan"]
    },
    {
      "id": "alerts-delivery",
      "name": "Alerts Delivery",
      "path": "alerts/infra",
      "description": "Event-driven alert delivery: QuickNode webhooks, Cloud Functions, Sentry bridge, Slack channel lifecycle, Splunk On-Call rotation announcements, related GCP resources, and stack-local trusted-main refresh grants.",
      "state": {
        "backend": "gcs",
        "bucket": "mento-terraform-tfstate-6ed6",
        "prefix": "alerts-infra"
      },
      "providers": [
        "archive",
        "github",
        "google",
        "http",
        "local",
        "null",
        "random",
        "restapi",
        "sentry"
      ],
      "ci": {
        "validate": "changed-paths",
        "plan": "pull-request",
        "apply": "push-main-production-infra-environment"
      },
      "applyPolicy": "ci-production-infra-environment-approved",
      "changedPathPatterns": [
        "alerts/infra/**",
        "terraform.stacks.json",
        "scripts/terraform/terraform-fmt-check.mjs",
        "scripts/tf-stacks.mjs",
        ".github/workflows/ci.yml",
        ".github/workflows/infra.yml",
        ".github/workflows/alerts-infra.yml"
      ],
      "aliases": ["pnpm alerts:infra:init", "pnpm alerts:infra:plan"]
    },
    {
      "id": "aegis",
      "name": "Aegis",
      "path": "aegis/terraform",
      "description": "Aegis Grafana dashboard and Aegis folder. Alert rules (including the Aegis service-health rule group) and global routing live in alerts-rules.",
      "state": {
        "backend": "gcs",
        "bucket": "mento-terraform-tfstate-6ed6",
        "prefix": "aegis"
      },
      "providers": ["grafana"],
      "ci": {
        "validate": "changed-paths",
        "plan": "pull-request",
        "apply": "push-main-production-infra-environment"
      },
      "applyPolicy": "ci-production-infra-environment-approved",
      "changedPathPatterns": [
        "aegis/terraform/**",
        "terraform.stacks.json",
        "scripts/terraform/terraform-fmt-check.mjs",
        "scripts/tf-stacks.mjs",
        ".github/workflows/ci.yml",
        ".github/workflows/infra.yml",
        ".github/workflows/aegis-terraform.yml"
      ],
      "aliases": ["pnpm aegis:tf:init", "pnpm aegis:tf:plan"]
    },
    {
      "id": "governance-watchdog",
      "name": "Governance Watchdog",
      "path": "governance-watchdog/infra",
      "description": "Mento Governance event watchdog: dedicated GCP project, Cloud Function (QuickNode webhook -> Discord/Telegram), QuickNode webhooks, Cloud Scheduler health check, Secret Manager, Cloud Monitoring alert policies, and stack-local trusted-main refresh grants. Owns its own GCP project; not part of the alerts-delivery mento-alerts project.",
      "state": {
        "backend": "gcs",
        "bucket": "mento-terraform-tfstate-6ed6",
        "prefix": "governance-watchdog"
      },
      "providers": [
        "archive",
        "github",
        "google",
        "google-beta",
        "local",
        "null",
        "random",
        "restapi",
        "time"
      ],
      "ci": {
        "validate": "changed-paths",
        "plan": "pull-request",
        "apply": "push-main-production-infra-environment",
        "drift": "scheduled"
      },
      "applyPolicy": "ci-production-infra-environment-approved",
      "changedPathPatterns": [
        "governance-watchdog/infra/**",
        "governance-watchdog/src/**",
        "governance-watchdog/package.json",
        "governance-watchdog/pnpm-lock.yaml",
        "governance-watchdog/pnpm-workspace.yaml",
        "governance-watchdog/tsconfig.json",
        "governance-watchdog/tsconfig.build.json",
        "terraform.stacks.json",
        "scripts/terraform/terraform-fmt-check.mjs",
        "scripts/tf-stacks.mjs",
        ".github/workflows/ci.yml",
        ".github/workflows/infra.yml",
        ".github/workflows/governance-watchdog.yml"
      ],
      "aliases": ["pnpm gov-watchdog:tf:init", "pnpm gov-watchdog:tf:plan"]
    }
  ]
}

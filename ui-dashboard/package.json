{
  "name": "@mento-protocol/ui-dashboard",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 111",
    "Safari >= 16.4"
  ],
  "scripts": {
    "dev": "node scripts/dev-with-live-hasura.mjs",
    "codegen": "node scripts/generate-graphql-types.mjs",
    "build": "next build",
    "fixture-build": "node scripts/fixture-build.mjs",
    "start": "next start",
    "lint": "node ../scripts/eslint-baseline-diff.mjs check",
    "lint:baseline:update": "node ../scripts/eslint-baseline-diff.mjs update",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:browser:production": "node scripts/run-browser-tests.mjs --production",
    "test:browser:update-snapshots": "node scripts/run-browser-tests.mjs --update-snapshots",
    "lighthouse:pool-fixture": "node scripts/run-pool-lighthouse.mjs",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:canary": "node ../scripts/repo-health/mutation-harness-canary.mjs",
    "react-doctor": "react-doctor .",
    "react-doctor:diff": "bash ./scripts/check-react-doctor-diff.sh \"${REACT_DOCTOR_BASE_REF:-origin/main}\"",
    "react-doctor:score": "bash ./scripts/check-react-doctor-score.sh",
    "knip": "knip --config knip.json --no-progress",
    "knip:report": "knip --config knip.json --no-exit-code --no-progress",
    "size-limit": "size-limit"
  },
  "dependencies": {
    "@mento-protocol/config": "workspace:*",
    "@mento-protocol/ui": "0.1.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@sentry/nextjs": "^11.0.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.1",
    "@web3icons/react": "^4.1.24",
    "graphql": "^17.0.2",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "plotly.js": "npm:plotly.js-basic-dist-min@4.1.2",
    "plotly.js-basic-dist-min": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "4.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "viem": "catalog:",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/plotly.js": "3.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "0.10.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "knip": "6.12.2",
    "react-doctor": "0.1.6",
    "size-limit": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.12",
    "vitest-axe": "1.0.0-pre.5",
    "web-vitals": "^6.2.1"
  }
}
